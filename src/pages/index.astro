---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const posts = sortMDByDate(await getBlogCollection()).slice(0, 5)
---

<PageLayout meta={{ title: '首页' }}>
  <main class='home mx-auto w-full max-w-[48rem]'>
    <section id='content-header' class='animate hero'>
      <p class='eyebrow'>XINGLAN233 / BLOG</p>
      <h1>记录、思考<br />与日常。</h1>
      <p class='intro'>一个安静的角落，留给文字与想法。</p>
      <a class='profile-link' href='https://github.com/Xinglan233' rel='me'>
        <Icon name='github' class='size-4' /> GitHub <span aria-hidden='true'>↗</span>
      </a>
    </section>
    <section id='content' class='animate latest'>
      <div class='section-heading'>
        <h2>最近更新</h2><a href='/blog'>全部文章 <span aria-hidden='true'>↗</span></a>
      </div>
      <ul class='flex flex-col gap-y-3'>
        {
          posts.map((post) => (
            <li>
              <PostPreview {post} detailed />
            </li>
          ))
        }
      </ul>
    </section>
    <div class='animate bottom-note'>
      <span>保持简单，慢慢积累。</span>
      <Button title='关于这个博客' href='/about' variant='ahead' />
    </div>
  </main>
</PageLayout>
<style>
  .hero {
    padding: 4rem 0 5rem;
  }
  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: hsl(var(--muted-foreground));
  }
  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.7rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }
  .intro {
    margin-top: 1.5rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.9;
  }
  .profile-link {
    margin-top: 1.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  h2 {
    font-size: 1rem;
    font-weight: 500;
  }
  .section-heading a,
  .bottom-note {
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
  }
  .bottom-note {
    margin-top: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .hero {
      padding: 2.25rem 0 3.5rem;
    }
    .bottom-note {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
