---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}
const { headings } = Astro.props
---

<nav aria-label='文章目录'>
  <h2 class='font-medium'>文章目录</h2>
  <ul class='mt-4 flex flex-col gap-y-3 text-sm text-muted-foreground'>
    {
      headings
        .filter((heading) => heading.depth > 1 && heading.depth < 4)
        .map((heading) => (
          <li class={heading.depth === 3 ? 'ms-4' : ''}>
            <a class='hover:text-primary' href={`#${heading.slug}`}>
              {heading.text}
            </a>
          </li>
        ))
    }
  </ul>
</nav>
